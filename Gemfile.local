group :assets do
  gem 'sass-rails'
  gem 'coffee-rails'
  gem 'uglifier'
end

group :test do
  gem 'cucumber-rails'
  gem 'database_cleaner'
  gem 'mocha'
  gem 'rspec-rails'
end
