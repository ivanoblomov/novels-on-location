source 'http://rubygems.org'

gem 'bson_ext'
gem 'cancan'
gem 'google_maps_geocoder', :path => '~/Documents/code/google_maps_geocoder'
gem 'httparty'
gem 'jquery-rails'
gem 'mongoid_slug'
gem 'rack-rewrite'
gem 'rails'
gem 'scaffold_logic', :path => '~/Documents/projects/scaffold_logic'
gem 'sucker'
gem 'thin'
