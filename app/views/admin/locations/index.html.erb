<%- if @locations.empty? -%>
  <p><em>No locations found. Why don't you <%= link_to 'add some', root_path -%>?
</em></p>
<%- else -%>
  <table class="standard">
    <tr>
      <th></th>
      <th><%= sort_link 'admin/locations', 'title', params -%> / <%= sort_link 'admin/locations', 'address', params -%></th>
      <th><%= sort_link 'admin/locations', 'author', params -%></th>
      <th><%= sort_link 'admin/locations', 'tags', params -%></th>
      <th><%= sort_link 'admin/locations', 'notes', params -%></th>
      <th><%= sort_link 'admin/locations', 'show_info?', params -%></th>
      <th>Added by</th>
      <th> </th>
    </tr>

  <%- for location in @locations -%>
    <tr class="<%= cycle('odd', 'even') -%>">
      <td><%= link_to image_tag(location.image_url, :alt => "Cover of #{location.title}", :class => 'thumbnail', :height => location.image_height, :width => location.image_width), location.url, :target => '_blank', :title => "Go to #{location.title} on Amazon" if location.image_url -%></td>
      <td>
        <%= link_to location.title, location.url -%><br/>
        <%= link_to location.address, location -%>
      </td>
      <td><%= wikipedia_link_to location.author -%></td>
      <td><%= google_link_to location.tags unless location.tags.blank? -%></td>
      <td><%= location.notes -%></td>
      <td><%= location.show_info? ? '√' : nil -%></td>
      <td> </td>
      <td class="crud_links"><%= crud_links location, [:show, :destroy] -%></td>
    </tr>
  <%- end -%>
  </table>
<%- end -%>