<div class=row>
  <h1><%= default_title %></h1>

  <div id=sorter>
    Sort by:
    <ul>
      <li><%= sort_link 'admin/locations', 'address', params %></li>
      <li><%= sort_link 'admin/locations', 'author', params %></li>
      <li><%= sort_link 'admin/locations', 'created_at', params %></li>
      <li><%= sort_link 'admin/locations', 'duplicate?', params %></li>
      <li><%= sort_link 'admin/locations', 'notes', params %></li>
      <li><%= sort_link 'admin/locations', 'tags', params %></li>
      <li><%= sort_link 'admin/locations', 'title', params %></li>
      <li><%= sort_link 'admin/locations', 'user_id', params %></li>
    </ul>
  </div>
</div>
<%
    i = 1
    @locations.to_a.in_groups_of(3, false) do |locations|
%>
<div class=row>
<%
      locations.each do |location|
%>
  <div class="booklet<%= '-duplicate' if location.duplicate? %> threecol<%= ' last' if locations.index(location) == 2 %>">
    <div class=booklet-header>
      <span class=booklet-index><%= i %></span>
      <%= link_to image_tag(location.image_url, :alt => "Cover of #{location.title}", :class => 'thumbnail', :height => location.image_height, :width => location.image_width), location.url, :target => '_blank', :title => "Check out #{location.title} on Amazon" if location.image_url %>
      <h2><%= link_to location.title, location.url, :target => '_blank' %></h2>
      <h3>by <%= wikipedia_link_to location.author %></h3>
    </div>
<%
        if location.address.present?
%>
    <h3>Set in <%= link_to location.address, location %></h3>
<%
        end
%>
        <% if location.review.present? %>
    <p><%= strip_tags location.review %></p>
        <% end
          if location.notes.present? %>
    <h3>Reader Notes</h3>
    <%= location.notes %>
        <% end %>
    <p class=metadata>
      Added
    <% if location.user_id.present? %>
      by <%= facebook_link_to location %>,
    <% end %>
      <%= location.added_at %><br/>
    <% unless location.tags.blank? %>Tags: <%= google_link_to location.tags %><% end %>
    </p>
  </div>
<%
      i += 1
      end
%>
</div>
<% end %>