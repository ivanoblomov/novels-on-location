<!DOCTYPE html>
<html<%= ' prefix="og: http://ogp.me/ns#"' if facebook? %>>
<head>
<meta charset=utf-8 /><%
  @meta_description ||= "A Google-Maps/Amazon mash-up for finding books that take place where you're traveling. Search the map and make your next destination come alive!"
  @og_tags ||= {}
  @og_tags = {
    'og:title' => 'Novels: On Location',
    'og:type' => 'website',
    'og:url' => request.url,
    'og:image' => 'http://a5.sphotos.ak.fbcdn.net/hphotos-ak-ash4/382738_351550844858963_345696682111046_1581971_1450028275_n.jpg'
  }.merge(@og_tags)
  @title ||= default_title
%>
<title><%= @title %></title>
<% unless w3c_validator? %><meta name=apple-itunes-app content="app-id=625973663<%= ",app-argument=http://#{Rails.application.config.main_host}/locations/#{@location.slug}" if @location %>"/><% end %>
<meta name=apple-mobile-web-app-capable content="yes"/>
<meta name=description content="<%= @meta_description %>"/><% unless w3c_validator? %>
<meta name="fragment" content="!"/><% end %>
<meta name=keywords content="<%= @meta_keywords || 'google maps, amazon, mash-up, novels, location, books, settings, map, travel' %>"/><% @og_tags.each do |property, content| %>
<meta property="<%= property %>" content="<%= content %>"/><% end if facebook? || Rails.env.development?; if params[:canonical_url] %>
<link rel=canonical href="<%= params[:canonical_url] %>"/><% end %>
<%= csrf_meta_tag %>
<%= auto_discovery_link_tag :rss, "https://www.facebook.com/feeds/page.php?id=345696682111046&format=atom10" %>
<style>
body{font-family:"Helvetica Neue",helvetica,arial,"Lucida Grande",sans-serif;font-size:10pt;margin:0;padding:0}
a{text-decoration:none}
a img{border:0}
h1{font-size:12pt}
h2{font-size:10pt;margin:-10px 0 10px 0}
h3{font-size:10pt;margin-bottom:-10px}
iframe#tweet{overflow:hidden}
input[type="button"]{border:0;cursor:pointer;font-weight:bold;padding:0 0 0 5px;text-align:left}
input.map[type="button"]{background:#3B5998;color:white;float:left}
.bullet{margin:2px .5em 0 .5em}
.clear{clear:both}
.links{float:right;margin:0;width:18px;height:18px}
.map-balloon{margin-right:15px}
.map-balloon input[type="button"]{background:white;color:blue;float:right;font-size:10pt;padding:0}
.search{color:#777;margin:0}
.search-links{float:right;font-size:10pt;font-weight:bold;padding:0}
.thumbnail{border:black 1px solid;float:left;margin-bottom:5px;margin-right:5px}
#appstore-link{margin:2px 0 0 3px}
#applesearch{float:left;top:6px}
#applesearch .sbox_l{background:url(<%= asset_path 'srch_l.gif' %>) no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox_r{background:url(<%= asset_path 'srch_r.gif' %>) no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox input{background:url(<%= asset_path 'srch_bg.gif' %>) repeat-x top left;border:0;float:left;font:11px/13px arial;padding:3px}
#book-input{width:101px}
#fb-like{border:0;float:left;width:100px;height:20px}
#fb-root{display:none}
#headers{bottom:10px;color:#fff;margin:10px;position:absolute;z-index:-1}
#login-button{background:#3B5998 url(http://static.ak.fbcdn.net/rsrc.php/v1/zL/r/FGFbc80dUKj.png) no-repeat;background-position:0% -188px;padding:0;text-align:right;width:77px;height:22px}
#mail-button{margin:3px 2px 0 1px}
#mode-button{width:98px;height:18px}
#pin-display-button{width:90px;height:18px}
#place-input{width:153px}
#map-canvas{position:absolute;bottom:0;left:0;right:0;top:0}
#social-toolbar{bottom:0;margin-left:40%;position:absolute}
#toolbar{position:absolute;right:156px;top:4px}
#tweet{border:0;float:right;width:130px;height:20px}
@media print{@page{size:landscape}
.no-print{display:none}
#headers{z-index:1}}</style>
<%= stylesheet_link_tag 'safari' if safari_pc? %><%= stylesheet_link_tag 'ie' if ie? %><%= stylesheet_link_tag 'ios' if ios? %><% if nibbler? %><%= stylesheet_link_tag 'mobile' %><%= stylesheet_link_tag 'print', :media => 'print' %><% end %>
<script>
  var _gaq = _gaq || [];
  _gaq.push(['_setAccount', 'UA-25642977-1']);
  _gaq.push(['_trackPageview']);
  (function() {
    var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
    ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
    var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
  })();
  var _tsq = _tsq || [];
  _tsq.push(["setAccountName", "novelsonlocation"]);
  _tsq.push(["enableGoogleAnalyticsIntegration", true]);
  _tsq.push(["fireHit", "javascript_tracker", []]);
  (function() {
      function z(){
          var s = document.createElement("script");
          s.type = "text/javascript";
          s.async = "async";
          s.src = window.location.protocol + "//cdn.tapstream.com/static/js/tapstream.js";
          var x = document.getElementsByTagName("script")[0];
          x.parentNode.insertBefore(s, x);
      }
      if (window.attachEvent)
          window.attachEvent("onload", z);
      else
          window.addEventListener("load", z, false);
  })();
</script>
</head>
<body>
<%= yield %>
<div id=map-canvas></div>
<div class=no-print id=toolbar>
<div id=applesearch>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=place-input placeholder="Enter a place name..."<% if safari_pc? %> autosave=applestyle_srch results=5<% end %> onkeyup="applesearch.onChange('place-input','clear_place')"/></span><span class=sbox_r id=clear_place></span>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=book-input placeholder="Enter a book keyword"<% if safari_pc? %> autosave=applestyle_srch results=5<% end %> onkeyup="applesearch.onChange('book-input','clear_book')"/></span><span class=sbox_r id=clear_book></span>
</div>
<input type=button class=map id=mode-button title="Double-click map to zoom. Click to toggle" value="Mode: Zoom"/>
<input type=button class=map id=pin-display-button title="Click to show only my pins" value="All Pins"/>
<%= link_to image_tag('http://r.mzstatic.com/images/web/linkmaker/badge_appstore-sm.gif', :alt => 'App Store', :width => 61, :height => 15), 'https://itunes.apple.com/us/app/novels-on-location/id625973663?mt=8&uo=4', :class => 'links', :id => 'appstore-link', :target => 'itunes_store' %>
<%= mail_to Rails.application.config.admin_email, image_tag('mail.png', :alt => 'Mail Icon', :width => 20, :height => 12), :encode => 'hex', :class => 'links', :id => 'mail-button', :title => 'Send feedback' %>
<%= link_to image_tag('gplus.png', :alt => 'Google+ Icon', :width => 18, :height => 18), 'https://plus.google.com/109501593522859919303', :class => 'links', :id => 'g-page', :title => 'Visit our Google+ page' %>
<%= link_to image_tag('facebook.png', :alt => 'Facebook Icon', :width => 18, :height => 18), 'http://www.facebook.com/NovelsOnLocation', :class => 'links', :id => 'fb-page', :title => 'Visit our Facebook page' %>
</div>
<div class=no-print id=social-toolbar>
<div id=fb-root></div><input type=button class=map id=login-button title="Log into Facebook" value="Log In &nbsp; "/>
<iframe<% if ie? %> allowTransparency=true frameBorder=0<% end %> id=fb-like src="https://www.facebook.com/plugins/like.php?layout=button_count&amp;href=<%= @location ? location_url(@location) : Rails.application.config.main_host.downcase %>"></iframe><% unless nibbler? %>
<iframe<% if ie? %> allowTransparency=true frameBorder=0<% end %> id=tweet src="//platform.twitter.com/widgets/tweet_button.html?url=<%= request.url %>"></iframe><% end %>
</div>
<script src="http://maps.google.com/maps/api/js?sensor=false"></script>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.2/jquery.min.js"></script>
<script src="http://platform.twitter.com/widgets.js"></script>
<%= javascript_include_tag 'application' %>
<script>
  window.fbAsyncInit=function(){
    nOL.init({
      defaultTitle: "<%= default_title %>",
      <%= "error: \"#{flash[:error]}\",".html_safe if flash[:error] %>
      fbAppId: <%= Rails.application.config.facebook_app_id %>,
      host: '<%= Rails.application.config.main_host %>',
      selectedLocationSlug: <%= (@location ? "'#{@location.slug}'" : 'null').html_safe %>,
    });
  };
  (function(d){
    var js, id = 'facebook-jssdk';
    if (d.getElementById(id))
      return;
    js = d.createElement('script');
    js.id = id;
    js.async = true;
    js.src = '//connect.facebook.net/en_US/all.js';
    d.getElementsByTagName('head')[0].appendChild(js);
  }(document));
</script>
</body>
</html>