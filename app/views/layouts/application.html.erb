<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"/>
<title><%= @title || "Novels: On Location - #{Location.book_count} Novels/#{Location.count} Locations" -%></title>
<meta name=apple-mobile-web-app-capable content="yes"/>
<meta name=description content="<%= @meta_description || "A Google-Maps/Amazon mash-up for finding books that take place where you're traveling. Search the map and make your next destination come alive!" -%>"/>
<meta name=keywords content="<%= @meta_keywords || 'google maps, amazon, mash-up, novels, location, books, settings, map, travel' -%>"/>
<%= auto_discovery_link_tag :rss, "https://www.facebook.com/feeds/page.php?id=#{Rails.application.config.facebook_app_id}&format=atom10" -%>
<style>html{height:100%}
body{font-family:"Helvetica Neue", helvetica, arial, "Lucida Grande", sans-serif;font-size:10pt;height:100%;margin:0;padding:0}
a{text-decoration:none}
a img{border:0}
h1{font-size:12pt}
h2{font-size:10pt;margin:-10px 0 10px 0}
h3{font-size:10pt;margin-bottom:-10px}
input[type="button"]{border:0;cursor:pointer;font-weight:bold;padding:0 0 0 5px;text-align:left}
input.map[type="button"]{background:#3B5998;color:white;float:left}
.bullet{float:right;margin:2px .5em 0 .5em}
.clear{clear:both}
.map-balloon{margin-right:15px}
.map-balloon input[type="button"]{background:white;color:blue;float:right;font-size:10pt;padding:0}
.search{color:#777}
.thumbnail{border:black 1px solid;float:left;margin-bottom:5px;margin-right:5px}
.twitter-share-button{float:right;width:61px !important}
#applesearch{float:left;top:6px}
#applesearch .sbox_l{background:url('/images/srch_l.gif') no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox_r{background:url('/images/srch_r.gif') no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox input{background:url('/images/srch_bg.gif') repeat-x top left;border:0;float:left;font:11px/13px arial;padding:3px}
#book-input{width:101px}
#fb-like{border:none;float:left;width:100px;height:20px}
#fb-page{float:right;margin:0}
#fb-root{display:none}
#headers{bottom:10px;color:#fff;margin:10px;position:absolute;z-index:-1}
#login-button{background:#3B5998 url(http://static.ak.fbcdn.net/rsrc.php/v1/zL/r/FGFbc80dUKj.png) no-repeat;background-position:0% -188px;padding:0;text-align:right;width:77px;height:22px}
#mail-button{float:right;margin:3px 2px 0 1px}
#mode-button{width:98px;height:18px}
#pin-display-button{width:90px;height:18px}
#place-input{width:153px}
#map-canvas{height:100%;position:absolute;bottom:0;left:0;right:0;top:0}
#social-toolbar{bottom:0;margin-left:40%;position:absolute}
#toolbar{position:absolute;right:111px;top:4px}
@media print{@page{size:landscape}
.no-print{display:none}
#headers{z-index:1}}</style>
<%= stylesheet_link_tag 'safari' if safari_pc? -%>
<%= stylesheet_link_tag 'ie' if ie? -%>
<%= stylesheet_link_tag 'ios' if ios? -%>
<script src="http://maps.google.com/maps/api/js?sensor=false"></script>
<%= csrf_meta_tag -%> <script>var _gaq=_gaq||[];_gaq.push(['_setAccount','UA-25642977-1']);_gaq.push(['_trackPageview']);(function(){var ga=document.createElement('script');ga.type='text/javascript';ga.async=true;ga.src=('https:'==document.location.protocol?'https://ssl':'http://www')+'.google-analytics.com/ga.js';var s=document.getElementsByTagName('script')[0];s.parentNode.insertBefore(ga,s);})();</script>
</head>
<body>
<%= yield -%>
<div id=map-canvas></div>
<div class=no-print id=toolbar>
<div id=applesearch>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=place-input placeholder=Search...<%- if safari_pc? -%> autosave=applestyle_srch results=5<%- end -%> onkeyup="applesearch.onChange('place-input','clear_place')"/></span><span class=sbox_r id=clear_place></span>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=book-input placeholder=Search...<%- if safari_pc? -%> autosave=applestyle_srch results=5<%- end -%> onkeyup="applesearch.onChange('book-input','clear_book')"/></span><span class=sbox_r id=clear_book></span>
</div>
<input type=button class=map id=mode-button title="Double-click map to zoom. Click to toggle" value="Mode: Zoom"/>
<input type=button class=map id=pin-display-button title="Click to show only my pins" value="Show My Pins"/>
<%= mail_to Rails.application.config.admin_email, image_tag('mail.png', :alt => 'Mail Icon', :width => 20, :height => 12), :encode => 'hex', :id => 'mail-button', :title => 'Send feedback' -%>
<%= link_to image_tag('facebook.png', :alt => 'Facebook Icon', :width => 18, :height => 18), "http://www.facebook.com/apps/application.php?id=#{Rails.application.config.facebook_app_id}", :id => 'fb-page', :title => 'Visit our Facebook page' -%>
</div>
<div class=no-print id=social-toolbar>
<div id=fb-root></div><input type=button class=map id=login-button title="Log into Facebook" value="Log In &nbsp; "/>
<iframe<%- if ie? -%> allowTransparency="true" frameBorder="0"<%- end -%> id=fb-like src="https://www.facebook.com/plugins/like.php?layout=button_count&amp;href=<%= @location ? location_url(@location) : Rails.application.config.main_host -%>"></iframe>
<a href="http://twitter.com/share" class=twitter-share-button data-count=none>Tweet</a>
</div>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.2/jquery.min.js"></script>
<script src="http://platform.twitter.com/widgets.js"></script>
<%= javascript_include_tag 'jquery_ujs', 'shortcut', Rails.env.development? ? 'application' : 'application.min' -%>
<script>host = '<%= Rails.application.config.main_host -%>';
window.fbAsyncInit=function(){
initializeMap(<%= params[:id] ? "'#{params[:id]}'" : '' -%>);
FB.init({appId:'<%= Rails.application.config.facebook_app_id -%>',cookie:true,status:true});
FB.getLoginStatus(function(response){if(response.session){captureFacebookSession(response.session);setPinDisplayPrompt();getFriends();labelFacebookButton('Log Out\u00a0','Log out of Facebook');};listenForLogin();});<%- if flash[:error] -%>alert("<%= flash[:error] -%>");<%- end -%>};
(function(d, s, id) {
var js, fjs = d.getElementsByTagName(s)[0];
if (d.getElementById(id)) {return;}
js = d.createElement(s); js.id = id;
js.src = "//connect.facebook.net/en_US/all.js#xfbml=1";
fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));
</script>
</body>
</html>