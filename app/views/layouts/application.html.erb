<!DOCTYPE html>
<html>
<head>
  <title>NovelsOnLocation</title>
  <style type="text/css">
    html {
      height: auto;
    }

    body {
      font: 10pt helvetica,sans-serif;
      height: auto;
      margin: 0;
      padding: 0;
    }

    input.search {
      width: 225px;
    }

    .button {
      float: right;
      margin-top: 10px;
    }

    .map-balloon {
      margin-right: 15px;
    }

    #map-canvas {
      height: auto;
      position: absolute;
      bottom:0;
      left:0;
      right:0;
      top:0;
    }

    #books-search-box {
      position: absolute;
      top: 4px;
      right: 338px;
    }

    #places-search-box {
      position: absolute;
      top: 4px;
      right: 106px;
    }

    @media print {
      #map-canvas {
        height: 950px;
      }
    }
  </style>
  <script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
  <%= javascript_include_tag :defaults %>
  <%= csrf_meta_tag %>
</head>
<body onLoad="initializeMap();">

<%= yield %>

</body>
</html>
