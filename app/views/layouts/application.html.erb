<!DOCTYPE html>
<html>
<head>
  <title>Novels: On Location - <%= "#{Location.book_count} Novels/#{Location.count} Locations" -%></title>
  <style type="text/css">
    html {
      height: auto;
    }

    body {
      font: 10pt helvetica,sans-serif;
      height: auto;
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }

    h1 {
      font-size: 12pt;
    }

    h2 {
      font-size: 10pt;
      margin: -10px 0 10px 0;
    }

    .button {
      float: right;
      margin-top: 0;
    }

    .map-balloon {
      margin-right: 15px;
    }

    .search {
      color: #777;
    }

    .thumbnail {
      border: black 1px solid;
      float: left;
      margin-bottom: 5px;
      margin-right: 5px;
    }

    #book-input {
      width: 153px;
    }

    #mode-div {
      position: absolute;
      top: 5px;
      right: 467px;
    }

    #place-input {
      width: 210px;
    }

    #map-canvas {
      height: auto;
      position: absolute;
      bottom:0;
      left:0;
      right:0;
      top:0;
    }

    #applesearch {
      position: absolute;
      top: 4px;
      right: 106px;
    }

    #applesearch .sbox input {
      float: left;
    }

    @media print {
      #map-canvas {
        height: 950px;
      }
    }
  </style>
  <%= stylesheet_link_tag 'not_safari', :id => 'search-stylesheet' unless request.user_agent =~ /safari/i -%>
  <script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
  <%= javascript_include_tag :defaults %>
  <%= csrf_meta_tag %>
</head>
<body onLoad="initializeMap();">

<%= yield %>

</body>
</html>
