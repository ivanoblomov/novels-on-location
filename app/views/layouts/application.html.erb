<!DOCTYPE html>
<html<%= ' prefix="og: http://ogp.me/ns#"' if facebook? %>>
<head>
<meta charset=utf-8 /><%
  @meta_description ||= "A Google Maps & Books mash-up for finding books that take place where you're traveling. Search the map and make your next destination come alive!"
  @og_tags ||= {}
  @og_tags = {
    'og:title' => 'Novels: On Location',
    'og:type' => 'website',
    'og:url' => request.url,
    'og:image' => 'http://a5.sphotos.ak.fbcdn.net/hphotos-ak-ash4/382738_351550844858963_345696682111046_1581971_1450028275_n.jpg'
  }.merge(@og_tags)
  @title ||= default_title
%>
<title><%= @title %></title>
<meta name=apple-itunes-app content="app-id=625973663<%= ",app-argument=http://#{Rails.application.config.main_host}/locations/#{@location.slug}" if @location %>"/>
<meta name=mobile-web-app-capable content="yes"/>
<meta name=description content="<%= @meta_description %>"/><% if w3c_validator? %>
<meta name="fragment" content="!"/><% end %>
<meta name=keywords content="<%= @meta_keywords || 'google maps, mash-up, novels, location, books, settings, map, travel' %>"/><% @og_tags.each do |property, content| %>
<meta property="<%= property %>" content="<%= content %>"/><% end if facebook? || Rails.env.development?; if params[:canonical_url] %>
<link rel=canonical href="<%= params[:canonical_url] %>"/><% end %>
<%= csrf_meta_tag %>
<%= auto_discovery_link_tag :rss, "https://www.facebook.com/feeds/page.php?id=345696682111046&format=atom10" %>
<style>
iframe#tweet{overflow:hidden}
input[type="button"]{border:0;cursor:pointer;font-weight:bold;padding:0 0 0 5px;text-align:left}
input.map[type="button"]{background:#3B5998;color:white;float:left}
.bullet{margin:2px .5em 0 .5em}
.clear{clear:both}
.links{float:right;margin:0;width:18px;height:18px}
.map-balloon{margin-right:15px}
.map-balloon input[type="button"]{background:white;color:blue;float:right;font-size:10pt;padding:0}
.search{color:#777;margin:0}
.search-links{float:right;font-size:10pt;font-weight:bold;padding:0}
.thumbnail{border:black 1px solid;float:left;margin-bottom:5px;margin-right:5px}
a.store{background:url(http://linkmaker.itunes.apple.com/images/badges/en-us/badge_ibooks-sm.svg) no-repeat;display:inline-block;margin:0 0 2px 0;overflow:hidden;width:65px;height:15px}
#appstore-link{margin:2px 0 0 3px}
#applesearch{float:left;top:6px}
#applesearch .sbox_l{background:url(<%= asset_path 'srch_l.gif' %>) no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox_r{background:url(<%= asset_path 'srch_r.gif' %>) no-repeat top left;float:left;width:19px;height:19px}
#applesearch .sbox input{background:url(<%= asset_path 'srch_bg.gif' %>) repeat-x top left;border:0;float:left;font:11px/13px arial;padding:3px}
#book-input{width:101px}
#headers{bottom:10px;color:#fff;margin:10px;position:absolute;z-index:-1}
#integration-link{bottom:2px;color:#fff;font-weight:bold;margin-left:9%;position:absolute}
#mail-button{margin:3px 2px 0 1px}
#mode-button{width:98px;height:18px}
#pin-display-button{width:100px;height:18px}
#place-input{width:153px}
#map-canvas{position:absolute;bottom:0;left:0;right:0;top:0;width:100%;height:100%}
#social-toolbar{bottom:0;margin-left:40%;position:absolute}
#toolbar{position:absolute;right:156px;top:4px}
#tweet{border:0;width:61px;height:20px}
</style>
<link rel="shortcut icon" href="favicon.ico?v=2"/>
<%= stylesheet_link_tag 'default' %>
<%= stylesheet_link_tag 'safari' if safari_pc? %>
<%= stylesheet_link_tag 'ie' if ie? %>
<%= stylesheet_link_tag 'ios' if ios? %>
<%= stylesheet_link_tag 'print', :media => 'print' %>
<%= javascript_include_tag 'google_analytics' %>
</head>
<body>
<%= yield %>
<div id=map-canvas></div>
<div class=no-print id=toolbar>
<div id=applesearch>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=place-input placeholder="Enter a place name..."<% if safari_pc? %> autosave=applestyle_srch results=5<% end %> onkeyup="applesearch.onChange('place-input','clear_place')"/></span><span class=sbox_r id=clear_place></span>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=book-input placeholder="Enter a book keyword"<% if safari_pc? %> autosave=applestyle_srch results=5<% end %> onkeyup="applesearch.onChange('book-input','clear_book')"/></span><span class=sbox_r id=clear_book></span>
</div>
<input type=button class=map id=mode-button title="Double-click map to zoom. Click to toggle" value="Mode: Zoom"/>
<input type=button class=map id=pin-display-button title="Click to show only my pins" value="Pins: All"/>
<%# link_to image_tag('http://r.mzstatic.com/images/web/linkmaker/badge_appstore-sm.gif', :alt => 'App Store'), 'https://itunes.apple.com/us/app/novels-on-location/id625973663?mt=8&uo=4', :class => 'links', :id => 'appstore-link', :target => 'itunes_store' %>
<%= mail_to Rails.application.config.admin_email, image_tag('mail.png', :alt => 'Mail Icon'), :encode => 'hex', :class => 'links', :id => 'mail-button', :title => 'Send feedback' %>
<%= link_to image_tag('facebook.png', :alt => 'Facebook Icon'), 'http://www.facebook.com/NovelsOnLocation', :class => 'links', :id => 'fb-page', :title => 'Visit our Facebook page' %>
</div>
<a class=no-print href="/integration" id=integration-link title="Learn how to integrate Novels: On Location with your site">N:OL Integration Notes</a>
<div class=no-print id=social-toolbar>
<% unless w3c_validator? %><div class="fb-login-button" id="login-button" data-max-rows="1" data-size="small" data-button-type="login_with" data-show-faces="false" data-auto-logout-link="true" data-use-continue-as="false"></div><% end %>
<div class="fb-like" id="fb-like" data-href="<%= @location ? location_url(@location) : Rails.application.config.main_host.downcase %>" data-layout="button_count" data-action="like" data-show-faces="false"></div>
<iframe<% if ie? %> allowTransparency=true frameBorder=0<% end %> id=tweet src="//platform.twitter.com/widgets/tweet_button.html?url=<%= request.url %>"></iframe>
<a href="https://twitter.com/novelsonloc" class="twitter-follow-button" data-show-count="false">Follow @novelsonloc</a>
</div>
<script src="http://maps.google.com/maps/api/js<%= "?v=3.53&key=#{ENV['GOOGLE_MAPS_API_KEY']}" %>"></script>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script src="http://platform.twitter.com/widgets.js"></script>
<%= javascript_include_tag 'application' %>
<script>
    nOL.init({
      defaultTitle: "<%= default_title %>",
      <%= "error: \"#{flash[:error]}\",".html_safe if flash[:error] %>
      fbAppId: <%= Rails.application.config.facebook_app_id %>,
      host: '<%= Rails.application.config.main_host %>',
      selectedLocationSlug: <%= (@location ? "'#{@location.slug}'" : 'null').html_safe %>,
    });
</script>
</body>
</html>
