<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="http://www.facebook.com/2008/fbml">
<head>
  <title>Novels: On Location - <%= "#{Location.book_count} Novels/#{Location.count} Locations" -%></title>
  <style type="text/css">
    html {
      height: auto;
    }

    body {
      font-family: "Helvetica Neue", helvetica, arial, "Lucida Grande", sans-serif;
      font-size: 10pt;
      height: auto;
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }

    h1 {
      font-size: 12pt;
    }

    h2 {
      font-size: 10pt;
      margin: -10px 0 10px 0;
    }

    h3 {
      font-size: 10pt;
      margin-bottom: -10px;
    }

    input[type="button"] {
      background: #3B5998;
      border: 0;
      color: white;
      cursor: pointer;
      float: left;
      font-weight: bold;
      padding: 0 0 0 5px;
      text-align: left;
    }

    .map-balloon {
      margin-right: 15px;
    }

    .map-balloon input[type="button"] {
      background: white;
      color: blue;
      float: right;
      font-size: 10pt;
      padding: 3px;
    }

    .search {
      color: #777;
    }

    .thumbnail {
      border: black 1px solid;
      float: left;
      margin-bottom: 5px;
      margin-right: 5px;
    }

    #applesearch {
      float: left;
      top: 6px;
    }

    #applesearch .sbox_l  {
      background: url('/images/srch_l.gif') no-repeat top left;
      float: left;
      width: 19px;
      height: 19px;
    }

    #applesearch .sbox_r  {
      background: url('/images/srch_r.gif') no-repeat top left;
      float: left;
      width: 19px;
      height: 19px;
    }

    #applesearch .sbox input {
      background: url('/images/srch_bg.gif') repeat-x top left;
      border: 0;
      float: left;
      font: 11px/13px arial;
      padding: 3px;
    }

    #book-input {
      width: 101px;
    }

    #fb-root {
      display: none;
    }

    #login-button {
      background: #3B5998 url(http://static.ak.fbcdn.net/rsrc.php/v1/zL/r/FGFbc80dUKj.png) no-repeat;
      background-position: 0% -188px;
      padding: 0;
      text-align: right;
      width: 77px;
      height: 22px;
    }

    #mode-button {
      width: 98px;
      height: 22px;
    }

    #pin-display-button {
      width: 90px;
      height: 22px;
    }

    #place-input {
      width: 153px;
    }

    #map-canvas {
      height: auto;
      position: absolute;
      bottom:0;
      left:0;
      right:0;
      top:0;
    }

    #toolbar {
      position: absolute;
      right: 105px;
      top: 4px;
    }

    @media print {
      #map-canvas {
        height: 950px;
      }
    }
  </style>
  <%= stylesheet_link_tag 'safari' if request.user_agent =~ /safari/i -%>
  <%= stylesheet_link_tag 'ios' if request.user_agent =~ /ipad|iphone/i -%>
  <script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
  <%= csrf_meta_tag -%>
</head>
<body onload="initializeMap()">

<div id="map-canvas"></div>

<div id="toolbar">
  <div id="applesearch">
    <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="place-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('place-input','clear_place')" /></span><span class="sbox_r" id="clear_place"></span>
    <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="book-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('book-input','clear_book')" /></span><span class="sbox_r" id="clear_book"></span>
  </div>
  <input type="button" id="mode-button" onclick="toggleMapMode()" title="Double-click map to zoom. Click to toggle" value="Mode: Zoom" />
  <input type="button" id="pin-display-button" onclick="togglePinDisplay()" title="Click to show only my pins" value="Show My Pins" />
  <div id="fb-root"></div><input type="button" id="login-button" title="Log into Facebook" value="Log In &nbsp; " />
</div>

<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.2/jquery.min.js"></script>
<%= javascript_include_tag 'jquery_ujs', 'application' -%>
<script type="text/javascript">
//<![CDATA[
  window.fbAsyncInit = function() {
    FB.init({
      appId:'<%= Rails.application.config.facebook_app_id -%>',
      cookie:true,
      status:true,
      xfbml:true
    });
    FB.getLoginStatus(function(response) {
      if (response.session) {
        captureFacebookSession(response.session);
        setPinDisplayPrompt();
        getFriends();
        claimMyPins();
        listenForLogout();
      } else
        listenForLogin();
    });
  };
  (function() {
    var e = document.createElement('script');
    e.async = true;
    e.src = document.location.protocol + '//connect.facebook.net/en_US/all.js';
    document.getElementById('fb-root').appendChild(e);
  }());
//]]>
</script>
</body>
</html>
