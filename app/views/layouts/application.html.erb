<!DOCTYPE html>
<html>
<head>
  <title>Novels: On Location - <%= "#{Location.book_count} Novels/#{Location.count} Locations" -%></title>
  <style type="text/css">
    html {
      height: auto;
    }

    body {
      font: 10pt helvetica,sans-serif;
      height: auto;
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }

    h1 {
      font-size: 12pt;
    }

    h2 {
      font-size: 10pt;
      margin: -10px 0 10px 0;
    }

    .button {
      float: right;
      margin-top: 0;
    }

    .map-balloon {
      margin-right: 15px;
    }

    .search {
      color: #777;
    }

    .thumbnail {
      border: black 1px solid;
      float: left;
      margin-bottom: 5px;
      margin-right: 5px;
    }

    #book-input {
      width: 153px;
    }

    #mode-div {
      position: absolute;
      top: 5px;
      right: 467px;
    }

    #place-input {
      width: 210px;
    }

    #map-canvas {
      height: auto;
      position: absolute;
      bottom:0;
      left:0;
      right:0;
      top:0;
    }

    #applesearch {
      position: absolute;
      top: 4px;
      right: 106px;
    }

    #applesearch .sbox input {
      float: left;
    }

    @media print {
      #map-canvas {
        height: 950px;
      }
    }
  </style>
  <%= stylesheet_link_tag 'not_safari', :id => 'search-stylesheet' unless request.user_agent =~ /safari/i -%>
  <script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
  <script type="text/javascript">
  //<![CDATA[
    // Add a script element as a child of the body
    function downloadJSAtOnload() {
      var sources = ['/javascripts/jquery.min.js', '/javascripts/jquery_ujs.js', '/javascripts/application.js'];

      for (var i = 0; i < sources.length; i++) {
       var element = document.createElement('script');
       element.src = sources[i];
       document.body.appendChild(element);
      }
    }

    // Check for browser support of event handling capability
    if (window.addEventListener)
      window.addEventListener('load', downloadJSAtOnload, false);
    else if (window.attachEvent)
      window.attachEvent('onload', downloadJSAtOnload);
    else window.onload = downloadJSAtOnload;
  //]]>
  </script>
  <%= csrf_meta_tag %>
</head>
<body>

<div id="map-canvas"></div>

<div id="applesearch">
  <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="place-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('place-input','clear_place')" /></span><span class="sbox_r" id="clear_place"></span>
  <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="book-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('book-input','clear_book')" /></span><span class="sbox_r" id="clear_book"></span>
</div>

<div id="mode-div" style="float: left"><input type="button" id="mode-button" onclick="toggleMapMode()" value="Double-Click Map to Zoom" /></div>

<script type="text/javascript">
//<![CDATA[
  var locations = [
    <%-
      @locations.each do |@location|
    -%>
      {'id': '<%= @location.id -%>', 'terms': "<%= escape_javascript( [@location.author, @location.title, @location.address, @location.tags] * ' ').strip -%>", 'latLng': <%= to_google_lat_lng(@location.lat_lng) -%>, 'content': '<%= render("location").strip.html_safe -%>', 'draggable': <%= can? :update, @location -%>},
    <%- end -%>
  ];
//]]>
</script>
</body>
</html>
