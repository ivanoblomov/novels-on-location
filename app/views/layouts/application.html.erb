<!DOCTYPE html>
<html>
<head>
  <title>Novels: On Location - <%= "#{Location.book_count} Novels/#{Location.count} Locations" -%></title>
  <style type="text/css">
    html {
      height: auto;
    }

    body {
      font: 10pt helvetica,sans-serif;
      height: auto;
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }

    h1 {
      font-size: 12pt;
    }

    h2 {
      font-size: 10pt;
      margin: -10px 0 10px 0;
    }

    .button {
      float: right;
      margin-top: 0;
    }

    .map-balloon {
      margin-right: 15px;
    }

    .search {
      color: #777;
    }

    .thumbnail {
      border: black 1px solid;
      float: left;
      margin-bottom: 5px;
      margin-right: 5px;
    }

    #book-input {
      width: 153px;
    }

    #fb-root {
      background: #3B5998 url(http://static.ak.fbcdn.net/rsrc.php/v1/zL/r/FGFbc80dUKj.png) no-repeat;
      background-position: 0% -188px;
      border: 0;
      color: white;
      float: left;
      font-weight: bold;
      margin: 1px 0;
      padding: 0;
      text-align: right;
      width: 77px;
      height: 22px;
    }

    #mode-button {
      float: left;
      margin: 3px 0;
      padding: 0;
    }

    #place-input {
      width: 210px;
    }

    #map-canvas {
      height: auto;
      position: absolute;
      bottom:0;
      left:0;
      right:0;
      top:0;
    }

    #toolbar {
      position: absolute;
      right: 106px;
      top: 4px;
    }

    #applesearch {
      float: left;
    }

    #applesearch .sbox input {
      float: left;
    }

    @media print {
      #map-canvas {
        height: 950px;
      }
    }
  </style>
  <%= stylesheet_link_tag 'not_safari', :id => 'search-stylesheet' unless request.user_agent =~ /safari/i -%>
  <script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
  <script src="http://connect.facebook.net/en_US/all.js"></script>
  <%= csrf_meta_tag -%>
</head>
<body onLoad="initializeMap();">

<div id="map-canvas"></div>

<div id="toolbar">
  <input type="button" id="mode-button" onclick="toggleMapMode()" title="Double-Click Map to Zoom" value="Zoom" />
  <div id="applesearch">
    <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="place-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('place-input','clear_place')" /></span><span class="sbox_r" id="clear_place"></span>
    <span class="sbox_l"></span><span class="sbox"><input type="search" class="search" id="book-input" placeholder="Search..." autosave="applestyle_srch" results="5" onkeyup="applesearch.onChange('book-input','clear_book')" /></span><span class="sbox_r" id="clear_book"></span>
  </div>
  <input type="button" id="fb-root" title="Log In to Facebook" value="Log In &nbsp; " />
</div>

<script type="text/javascript">
//<![CDATA[
  var locations = [
    <%- @locations.each do |@location| -%>
      {'id': '<%= @location.id -%>', 'terms': "<%= escape_javascript( [@location.author, @location.title, @location.address, @location.tags] * ' ').strip -%>", 'latLng': <%= to_google_lat_lng(@location.lat_lng) -%>, 'content': '<%= render("location").strip.html_safe -%>', 'draggable': <%= can? :update, @location -%>},
    <%- end -%>
  ];

  function initializeFacebook() {
    FB.init({
      appId:'<%= Rails.application.config.facebook_app_id -%>',
      cookie:true,
      status:true,
      xfbml:true
    });
  }
//]]>
</script>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.2/jquery.min.js"></script>
<%= javascript_include_tag 'jquery_ujs', 'application' -%>
</body>
</html>
