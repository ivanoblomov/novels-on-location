<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="http://www.facebook.com/2008/fbml">
<head>
<title>Novels: On Location - <%= "#{Location.book_count} Novels/#{Location.count} Locations" -%></title>
<meta name=description content="A Google-Maps/Amazon mash-up for finding books that take place where you're traveling. Browse or search the map and make your next destination come alive!"/>
<meta name=keywords content="google maps, amazon, mash-up, novels, location, books, settings, map, travel"/>
<%= auto_discovery_link_tag :rss, "http://www.facebook.com/feeds/page.php?id=#{Rails.application.config.facebook_app_id}&format=atom10" -%>
<style>html{height:100%;}
body{font-family:"Helvetica Neue", helvetica, arial, "Lucida Grande", sans-serif;font-size:10pt;height:100%;margin:0;padding:0;}
a{text-decoration:none;}
a img{border:0;}
h1{font-size:12pt;}
h2{font-size:10pt;margin:-10px 0 10px 0;}
h3{font-size:10pt;margin-bottom:-10px;}
input[type="button"]{background:#3B5998;border:0;color:white;cursor:pointer;float:left;font-weight:bold;padding:0 0 0 5px;text-align:left;}
.inline{display:inline}
.map-balloon{margin-right:15px;}
.map-balloon input[type="button"]{background:white;color:blue;float:right;font-size:10pt;padding:0;}
.search{color:#777;}
.thumbnail{border:black 1px solid;float:left;margin-bottom:5px;margin-right:5px;}
.twitter-share-button{float:right;width:61px !important;}
#applesearch{float:left;top:6px;}
#applesearch .sbox_l{background:url('/images/srch_l.gif') no-repeat top left;float:left;width:19px;height:19px;}
#applesearch .sbox_r{background:url('/images/srch_r.gif') no-repeat top left;float:left;width:19px;height:19px;}
#applesearch .sbox input{background:url('/images/srch_bg.gif') repeat-x top left;border:0;float:left;font:11px/13px arial;padding:3px;}
#book-input{width:101px;}
#fb-page{float:right;margin:3px 0px 2px 5px;}
#fb-root{display:none;}
#login-button{background:#3B5998 url(http://static.ak.fbcdn.net/rsrc.php/v1/zL/r/FGFbc80dUKj.png) no-repeat;background-position:0% -188px;padding:0;text-align:right;width:77px;height:22px;}
#mail-button{float:right;margin:3px 5px 2px 5px;}
#mode-button{width:98px;height:22px;}
#pin-display-button{width:90px;height:22px;}
#place-input{width:153px;}
#map-canvas{height:100%;position:absolute;bottom:0;left:0;right:0;top:0;}
#social-toolbar{bottom:0;margin-left:42%;position:absolute;}
#toolbar{position:absolute;right:105px;top:4px;}
@media print{@page{size:landscape}
.inline{color:#fff;display:block;position:relative;left:5px;top:10px;z-index:10}
.no-print{display:none}}</style>
<%= stylesheet_link_tag 'safari' if request.user_agent =~ /safari/i -%>
<%= stylesheet_link_tag 'ie' if request.user_agent =~ /msie/i -%>
<%= stylesheet_link_tag 'ios' if request.user_agent =~ /ipad|iphone/i -%>
<script src="http://maps.google.com/maps/api/js?sensor=false"></script>
<%= csrf_meta_tag -%> <script>var _gaq=_gaq||[];_gaq.push(['_setAccount','UA-25642977-1']);_gaq.push(['_trackPageview']);(function(){var ga=document.createElement('script');ga.type='text/javascript';ga.async=true;ga.src=('https:'==document.location.protocol?'https://ssl':'http://www')+'.google-analytics.com/ga.js';var s=document.getElementsByTagName('script')[0];s.parentNode.insertBefore(ga,s);})();</script>
</head>
<body>
<h1 class="inline">Novels: On Location</h1>
<h2 class="inline"><%= Rails.application.config.main_host -%> is a Google-Maps/Amazon mash-up for finding books that take place where you're traveling. Browse or search the map and make your next destination come alive!</h2>
<div id=map-canvas></div>
<div class=no-print id=toolbar>
<div id=applesearch>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=place-input placeholder=Search... autosave=applestyle_srch results=5 onkeyup="applesearch.onChange('place-input','clear_place')"/></span><span class=sbox_r id=clear_place></span>
<span class=sbox_l></span><span class=sbox><input type=search class=search id=book-input placeholder=Search... autosave=applestyle_srch results=5 onkeyup="applesearch.onChange('book-input','clear_book')"/></span><span class=sbox_r id=clear_book></span>
</div>
<input type=button id=mode-button title="Double-click map to zoom. Click to toggle" value="Mode: Zoom"/>
<input type=button id=pin-display-button title="Click to show only my pins" value="Show My Pins"/>
<%= mail_to "admin@#{Rails.application.config.main_host}", image_tag('mail.png', :alt => 'Mail Icon', :width => 15, :height => 10), :encode => 'hex', :id => 'mail-button', :title => 'Send Feedback' -%>
<%= link_to image_tag('facebook.png', :alt => 'Novels: On Location on Facebook', :width => 16, :height => 16), "http://www.facebook.com/apps/application.php?id=#{Rails.application.config.facebook_app_id}", :id => 'fb-page' -%>
</div>
<div class=no-print id=social-toolbar>
<div id=fb-root></div><input type=button id=login-button title="Log into Facebook" value="Log In &nbsp; "/>
<fb:like layout=button_count />
<a href="http://twitter.com/share" class=twitter-share-button data-count=none>Tweet</a>
</div>
<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.2/jquery.min.js"></script>
<script src="http://platform.twitter.com/widgets.js"></script>
<%= javascript_include_tag 'jquery_ujs', 'shortcut', 'application' -%><script>window.fbAsyncInit=function(){initializeMap();FB.init({appId:'<%= Rails.application.config.facebook_app_id -%>',cookie:true,status:true,xfbml:true});FB.getLoginStatus(function(response){if(response.session){captureFacebookSession(response.session);setPinDisplayPrompt();getFriends();claimMyPins();labelFacebookButton('Log Out\u00a0','Log out of Facebook');}
listenForLogin();});};(function(){var e=document.createElement('script');e.async=true;e.src=document.location.protocol+'//connect.facebook.net/en_US/all.js';document.getElementById('fb-root').appendChild(e);}());</script>
</body>
</html>