<div id="map-canvas"></div>

<div id="places-search-box">
  <%= text_field_tag 'place_criteria', nil, :class => 'search', :id => 'place-input' -%>
</div>

<div id="books-search-box">
  <%= text_field_tag 'book_criteria', nil, :class => 'search', :id => 'book-input' -%>
</div>

<script type="text/javascript">
//<![CDATA[
  var locations = [
    <%-
      @locations.each do |@location|
    -%>
      {'id': '<%= @location.id -%>', 'terms': "<%= escape_javascript @location.author -%> <%= escape_javascript @location.title -%>", 'latLng': <%= to_google_lat_lng(@location.lat_lng) -%>, 'content': '<%= render("location").strip -%>'},
    <%- end -%>
  ];
//]]>
</script>
