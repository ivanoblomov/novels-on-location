<div id="map-canvas"></div><br />

<div id="search-box">
  <%= text_field_tag 'criteria', params[:criteria], :id => 'search-input', :size => 40 -%>
</div>

<script type="text/javascript">
//<![CDATA[
    var locations = [
      <%-
        Location.all.each do |@location|
      -%>
        {'id': '<%= @location.id -%>', 'latLng': new google.maps.LatLng(<%= @location.lat_lng * ', ' -%>), 'content': '<%= render("location").strip -%>'},
      <%- end -%>
    ];
//]]>
</script>
