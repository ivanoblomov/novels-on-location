<% if html_snapshot? %><!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" /><%
    description = description_for_location @locations.first, @locations.size, location_kind
    @meta_keywords = @locations.map{ |l| l.tags } * ', '
    @og_tags = {
      'og:description' => description,
      'og:image' => location_kind == 'novel' ? @locations.first.image_url : 'http://a5.sphotos.ak.fbcdn.net/hphotos-ak-ash4/382738_351550844858963_345696682111046_1581971_1450028275_n.jpg',
      'og:title' => 'Novels: On Location',
      'og:type' => 'website',
      'og:url' => request.url
    }
  %>
  <meta name=description content="<%= description %>"/>
  <meta name=keywords content="<%= @meta_keywords || 'google maps, amazon, mash-up, novels, location, books, settings, map, travel' %>"/><% @og_tags.each do |property, content| %>
  <meta property="<%= property %>" content="<%= content %>"/><% end if facebook? || Rails.env.development? %>
  <title><%= default_title %></title>
  </head>
  <body>
    <div id=headers>
      <h1>Novels: On Location</h1>
      <h2><%= Rails.application.config.main_host %> is a Google-Maps/Amazon mash-up for finding books that take place where you're traveling. Browse or search the map and make your next destination come alive!</h2>
    </div>

    <ul>
    <%
      @locations.each do |l|
        @location = l
    %>
      <li><%= render 'location' %></li>
    <% end %>
    </ul>
  </body>
</html><% end %>