<div id="map-canvas"></div><br />

<div id="places-search-box">
  <%= text_field_tag 'place_criteria', params[:place_criteria] || 'Find a place', :id => 'place-input' -%>
</div>

<div id="books-search-box">
  <%= text_field_tag 'book_criteria', params[:book_criteria] || 'Find a mapped book', :id => 'book-input' -%>
</div>

<script type="text/javascript">
//<![CDATA[
    var locations = [
      <%-
        @locations.each do |@location|
      -%>
        {'id': '<%= @location.id -%>', 'title': '<%= @location.title -%>', 'latLng': <%= to_google_lat_lng(@location.lat_lng) -%>, 'content': '<%= render("location").strip -%>'},
      <%- end -%>
    ];
//]]>
</script>
