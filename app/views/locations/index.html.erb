<div id="map_canvas" style="margin: 0 0; width: 100%; height: 750px; float: left;"></div><br />

<script type="text/javascript">
//<![CDATA[
    var locations = [
      <%-
        Location.all.each do |@location|
      -%>
        {'id': '<%= @location.id -%>', 'latLng': new google.maps.LatLng(<%= @location.lat_lng * ', ' -%>), 'content': '<%= render("location").strip -%>'},
      <%- end -%>
    ];
//]]>
</script>
