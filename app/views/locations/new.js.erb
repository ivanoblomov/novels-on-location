<%- if @location.valid? -%>
if (confirm("Is this the book you meant? <%= j @location.title -%> by <%= j @location.author -%>")) nOL.createPin([<%= @location.lat_lng * ',' -%>], <%= filter_param @location.tags -%>, <%= filter_param @location.address -%>, <%= filter_param @location.asin -%>);
<%- else -%>
alert("Can't find the book '<%= j params[:location][:book_keywords] -%>'!");
<%- end -%>