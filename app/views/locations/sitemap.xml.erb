<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= root_url %></loc>
<% if l = Location.last_updated %>
    <lastmod><%= l.updated_at.to_s :w3c_datetime %></lastmod>
<% end %>
  </url>
<% @locations.each do |location| %>
  <url>
    <loc><%= location_url location %></loc>
  <% if location.updated_at %>
    <lastmod><%= location.updated_at.to_s :w3c_datetime %></lastmod>
  <% end %>
  </url>
  <url>
    <loc>http://<%= Rails.application.config.main_host %>/<%= novel_url location %></loc>
  </url>
  <url>
    <loc>http://<%= Rails.application.config.main_host %>/<%= place_url location %></loc>
  </url>
  <url>
    <loc>http://<%= Rails.application.config.main_host %>/<%= author_url location %></loc>
  </url><% if location.user_id %>
  <url>
    <loc>http://<%= Rails.application.config.main_host %>/<%= reader_url location %></loc>
  </url><% end %>
<% end %>
</urlset>