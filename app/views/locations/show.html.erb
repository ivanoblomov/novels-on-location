<%
  description = "#{@location.title}, a novel by #{@location.author} set in #{@location.address}, is mapped on #{Rails.application.config.main_host}."
  @meta_description = description
  @meta_keywords = @location.tags
  @title = "#{@location.title} - Novels: On Location"

  @og_tags = {
    'og:title' => description,
    'og:description' => strip_tags(@location.review).try(:strip),
    'og:type' => 'book',
    'og:image' => @location.image_url,
    'og:site_name' => 'Novels: On Location'
  }
%><%= render 'location' %>