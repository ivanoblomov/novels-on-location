<%
  @meta_description = "#{@location.title}, a novel by #{@location.author}, set in #{@location.address}" if @location.review
  @meta_keywords = @location.tags
  @title = "#{@location.title} - Novels: On Location"
%><% if true || @location.show_info? %><h1><%= link_to image_tag(@location.image_url, :alt => "Cover of #{@location.title}", :class => 'thumbnail', :height => @location.image_height, :width => @location.image_width), @location.url, :target => '_blank', :title => "Check out #{@location.title} on Amazon" if @location.image_url %><%= link_to @location.title, @location.url, :target => '_blank', :title => "Check out #{@location.title} on Amazon" %></h1><% end %>
<h2>by <%= wikipedia_link_to @location.author %></h2>
<h2><%= @location.address %></h2>
<p><%= @location.review.try :html_safe %></p>
<p>Added on <%= @location.added_at %><br/>
<% unless @location.tags.blank? %>Tags: <%= google_link_to @location.tags %></p><% end %>