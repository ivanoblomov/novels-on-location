<div class="map-balloon" id="open-balloon"><%- if @location.unowned? -%><input class="button" onClick="claimPin(\'<%= @location.id -%>\')" type="button" value="Claim" title="Claim This Pin" /><%- end -%><%= button_to 'Delete', @location, :confirm => 'Are you sure? This action cannot be undone.', :method => :delete, :remote => true, :class => 'button', :title => 'Delete This Pin' if can?(:destroy, @location) -%><%- if @location.owned? && can?(:update, @location) -%><input class="button" onClick="promptForTag(\'<%= @location.id -%>\', \'<%= escape_javascript @location.tags -%>\')" type="button" value="Tag" title="Tag Pin" /><%- end -%><input class="button" onClick="zoomIn(new google.maps.LatLng(<%= @location.lat_lng * ', ' -%>))" type="button" value="Zoom" title="Zoom to Pin" /><%= image_tag @location.image_url, :class => 'thumbnail', :height => @location.image_height, :width => @location.image_width -%><h1><%= link_to escape_javascript(@location.title), @location.url, :target => '_blank' -%></h1> <h2>by <%= link_to escape_javascript(@location.author), "http://en.wikipedia.org/wiki/#{@location.author.gsub(' ', '_')}", :target => '_blank' -%></h2><h2><%= escape_javascript @location.address -%></h2><p><%= raw escape_javascript @location.review -%></p><%- unless @location.tags.blank? -%><p>Tags: <%= link_to escape_javascript(@location.tags), "http://www.google.com/search?q=#{escape_javascript @location.tags}", :target => '_blank' -%></p><%- end -%></div>