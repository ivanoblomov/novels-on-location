<div class="map-balloon" id="open-balloon"><%= link_to @location.title, @location.url, :target => '_blank' -%> by <%= @location.author -%><br /><input class="button" onClick="zoomIn(<%= to_google_lat_lng(@location.lat_lng) -%>)" type="button" value="Zoom" id="zoom-<%= @location.id -%>" title="Zoom to Pin" /> <%= button_to 'Delete', @location, :confirm => 'Are you sure? This action cannot be undone.', :method => :delete, :remote => true, :class => 'button', :title => 'Delete This Pin' if can? :destroy, @location -%></div>
