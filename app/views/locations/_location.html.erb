<div class="map-balloon" id="open-balloon"><%= button_to 'Claim', {:action => 'update', :id => @location.id, :location => {:user_id => current_user.id}}, :method => :put, :remote => true, :class => 'button', :title => 'Claim This Pin' if @location.user_id.nil? -%><%= button_to 'Delete', @location, :confirm => 'Are you sure? This action cannot be undone.', :method => :delete, :remote => true, :class => 'button', :title => 'Delete This Pin' if @location.user_id && can?(:destroy, @location) -%><%- if @location.user_id && can?(:update, @location) -%><input class="button" onClick="promptForTag(\'<%= @location.id -%>\', \'<%= @location.tags -%>\')" type="button" value="Tag" id="tag-<%= @location.id -%>" title="Tag Pin" /><%- end -%><input class="button" onClick="zoomIn(<%= to_google_lat_lng(@location.lat_lng) -%>)" type="button" value="Zoom" id="zoom-<%= @location.id -%>" title="Zoom to Pin" /><%= image_tag @location.image_url, :class => 'thumbnail', :height => @location.image_height, :width => @location.image_width -%><%= link_to escape_javascript(@location.title), @location.url, :target => '_blank' -%> by <%= escape_javascript @location.author -%><p><%= raw escape_javascript @location.review -%></p><%- unless @location.tags.blank? -%><p>Tags: <%= link_to escape_javascript(@location.tags), "http://www.google.com/search?q=#{escape_javascript @location.tags}", :target => '_blank' -%></p><%- end -%></div>
