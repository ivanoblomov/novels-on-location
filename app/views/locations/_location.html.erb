<div class="map-balloon" id="open-balloon"><%= link_to @location.title, @location.url, :target => '_blank' -%> by <%= @location.author -%> <input type="button" value="Zoom" id="zoom-<%= @location.id -%>" title="Zoom to Pin" /> <%= button_to 'Delete', @location, :confirm => 'Are you sure? This action cannot be undone.', :method => :delete, :remote => true, :title => 'Delete This Pin' -%><br /><%= @location.lat_lng -%></div>
