<div class="map-balloon" id="open-balloon"><%= link_to escape_javascript(@location.title), @location.url, :target => '_blank' -%> by <%= escape_javascript @location.author -%><br /><input class="button" onClick="zoomIn(<%= to_google_lat_lng(@location.lat_lng) -%>)" type="button" value="Zoom" id="zoom-<%= @location.id -%>" title="Zoom to Pin" /> <%= button_to 'Claim', {:action => 'update', :id => @location.id, :location => {:user_id => current_user.id}}, :method => :put, :remote => true, :class => 'button', :title => 'Claim This Pin' if @location.user_id.nil? -%><%= button_to 'Delete', @location, :confirm => 'Are you sure? This action cannot be undone.', :method => :delete, :remote => true, :class => 'button', :title => 'Delete This Pin' if @location.user_id && can?(:destroy, @location) -%></div>
