/*= require_self */
a{font-size:10pt;font-weight:bold;padding:0;text-decoration:none}
body{font:10pt helvetica,sans-serif}
h2,h3{font-size:10pt}
html{background:#f7f5f5 url(<%= asset_path 'paper.jpg' %>) repeat}
p{margin:10px 0}
ul{display:inline;list-style-type:none;margin:0;padding:0}
ul li{display:inline;margin:0 10px}
.booklet{background:#fff;box-shadow:0 1px 3px #999;margin:5px;overflow:hidden;padding:15px;-moz-box-shadow:0 1px 3px #999;-webkit-box-shadow:0 1px 3px #999}
.booklet-header{overflow:auto}
.booklet-index{float:right}
.thumbnail{border:black 1px solid;float:left;margin:0 10px 5px 0}